# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
venv/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# PyTorch extensions
*.so
*.pyd

# Testing
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db
/wheelhouse/
*.pdf

# Local secrets (e.g. GH_TOKEN consumed by ci/release.py)
.env

# CI orchestration logs (loguru rotating sinks from ci/logging_setup.py)
/logs/

# CI publish artifacts: ci/run.py --serve-root defaults to ./public (local
# mode wheel tree); ci/release.py --pages-dir defaults to ./pages (gh-pages
# staging tree)
/public/
/pages/
